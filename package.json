{
  "name": "doctor-youtube-mcp-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP App that searches a doctor's YouTube channel and renders results as a playable video carousel inside the chat.",
  "scripts": {
    "build": "INPUT=mcp-app.html vite build",
    "serve": "npx tsx server.ts",
    "start": "npm run build && npm run serve",
    "dev": "npm run build && npm run serve"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.3"
  }
}

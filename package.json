{
  "name": "creator-picks-mcp-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP App that answers 'what do you use for this' with the creator's own product pick and a direct purchase link.",
  "scripts": {
    "build:app": "INPUT=mcp-app.html OUTDIR=dist vite build",
    "build:demo": "INPUT=index.html OUTDIR=public vite build",
    "build": "npm run build:app && npm run build:demo && node scripts/embed-widget.mjs",
    "typecheck": "tsc --noEmit",
    "serve": "npx tsx server.ts",
    "start": "npm run build && npm run serve",
    "dev": "npm run build && npm run serve",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "retire-leads": "tsx --env-file=.env scripts/retire-leads.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "postgres": "^3.4.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@vercel/node": "^3.2.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.3"
  }
}

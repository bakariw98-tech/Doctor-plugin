# Postgres connection string for the product catalog (src/db.ts) — the
# recommendations, the questions your audience asks, and the click counts
# all live here. Unlike the lead-capture feature this replaced, this is
# NOT optional: with no catalog there is nothing to recommend.
#
# Provisioning the database is a one-time manual step at supabase.com:
#   1. Create a project (free tier is fine).
#   2. Project Settings -> Database -> Connection string -> copy the
#      "Transaction pooler" string (port 6543) — this one, not "Direct
#      connection", since it's the one meant for serverless functions
#      that each open a fresh connection per request.
#   3. Replace [YOUR-PASSWORD] in it with your actual database password
#      (set when the project was created, or resettable from the same
#      Database settings page).
#   4. Paste the result here, and set the same value in Vercel's project
#      env vars (Settings -> Environment Variables) for the deployed app.
DATABASE_URL=

# Set to "1" to try the whole flow without a real database — the catalog,
# questions and clicks are kept in an in-process Map instead of Postgres.
# Good for previewing /admin and the recommendation cards before Supabase
# is set up. NOT for production: it resets on every restart (and on
# Vercel, on every single request — serverless functions don't share
# memory between invocations), so nothing you add this way is saved and
# no click is ever counted. Leave unset once DATABASE_URL is configured.
DEMO_MODE=

# Shared secret for the /admin dashboard — anyone with this token can
# rewrite what your plugin recommends to your audience, so make it long
# and random (e.g. `openssl rand -hex 24`) and treat it like a real
# password. Set the same value in Vercel's project env vars.
ADMIN_TOKEN=

# Lets /admin upload product photos, into Supabase Storage (see
# src/storage.ts). Without these two, /admin still works, but you have to
# host photos yourself and paste a URL — and a pasted URL only renders if
# its origin is on the widget's CSP allowlist (RESOURCE_DOMAINS in
# src/mcp-server.ts), which is why uploading is the recommended path.
#   1. SUPABASE_URL: your Supabase project's API URL, Project Settings ->
#      API -> Project URL, e.g. https://<project-ref>.supabase.co (same
#      project as DATABASE_URL above).
#   2. SUPABASE_SERVICE_ROLE_KEY: same page, "service_role" secret key.
#      This bypasses every access rule in the database — never expose it
#      to a browser or commit it; only set it as a server-side env var
#      here and in Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The public origin of this deployment, used to build the /r/<id> click
# redirect URLs handed to the widget. On Vercel this is detected
# automatically from VERCEL_PROJECT_PRODUCTION_URL, so you only need to
# set it if you serve from a custom domain or run behind a tunnel.
# Without it, buy links fall back to a relative /r/<id> path.
PUBLIC_BASE_URL=

# Port the server listens on locally.
PORT=3001

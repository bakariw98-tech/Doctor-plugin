# YouTube Data API v3 key.
# Create one at https://console.cloud.google.com/apis/credentials after
# enabling the "YouTube Data API v3" for your project.
YOUTUBE_API_KEY=

# The doctor's channel, identified one of two ways (only one is required):

# 1) Preferred — the channel ID (starts with "UC..."). Find it via
#    https://www.youtube.com/account_advanced while signed into the channel,
#    or by viewing the channel's page source for "channelId".
YOUTUBE_CHANNEL_ID=

# 2) Or the channel's public @handle, e.g. "DrExampleMD" (no "@").
#    Used only if YOUTUBE_CHANNEL_ID is not set.
YOUTUBE_CHANNEL_HANDLE=anthonychaffeemd

# Optional, and NOT read by the running server — only by the offline
# `npm run fetch-transcripts` script (see scripts/fetch-transcripts.ts).
# The deployed app never calls Supadata itself; this key just lets you
# build/refresh the local transcript dataset (data/transcripts.json) that
# gets embedded into the app at build time. Get one at
# https://dash.supadata.ai/organizations/api-key — only native
# (existing-caption) transcripts are ever fetched, never AI-generated
# ones, and the script skips videos already on file, so it's safe to
# re-run without re-spending credits on videos it's already checked.
#
# Do NOT set this in Vercel — it isn't used there.
SUPADATA_API_KEY=

# Postgres connection string, used by the lead-capture feature
# (offer_lead_magnet / submit_lead in src/mcp-server.ts, and the /admin
# dashboard) — see src/db.ts. Provisioning the database itself is a
# one-time manual step: in the Vercel dashboard, on this project, go to
# Storage -> Create Database -> Postgres (Neon-backed). That auto-adds
# the matching env var(s) to the Vercel project — check the exact name it
# used (DATABASE_URL is Neon's own convention; POSTGRES_URL is what the
# older @vercel/postgres integration used and some setups still mirror)
# and set the same value here for local dev. Pull it with `vercel env
# pull .env` instead of retyping it if you have the Vercel CLI set up.
#
# Without this set, search_doctor_videos and the demo still work fine —
# only offer_lead_magnet/submit_lead and /admin need it.
DATABASE_URL=

# Shared secret for the /admin leads dashboard — anyone with this token
# can read every captured lead, so make it long and random (e.g.
# `openssl rand -hex 32`) and treat it like a real password, not a
# placeholder. Set the same value in Vercel's project env vars.
ADMIN_TOKEN=

# Port the MCP server listens on locally.
PORT=3001
